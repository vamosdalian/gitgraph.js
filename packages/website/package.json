{
  "name": "@vamosdalian/gitgraph-website",
  "version": "0.0.11",
  "private": true,
  "description": "Historical GitGraph.js website source (not part of the maintained build)",
  "author": "Nicolas Carlo <nicolascarlo.espeon@gmail.com>",
  "contributors": [
    {
      "name": "Fabien Bernard",
      "email": "fabien0102@gmail.com"
    }
  ],
  "license": "MIT",
  "scripts": {
    "start": "mdx-deck deck.mdx",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "build": "npm run build:deck && npm run build:stories && npm run build:v1",
    "build:stories": "cd ../stories && npm run build -- -o ../website/dist/stories",
    "build:deck": "mdx-deck build deck.mdx && cp -R assets dist",
    "build:v1": "cp -R v1 dist",
    "github-files": "touch dist/.nojekyll"
  },
  "dependencies": {
    "@vamosdalian/gitgraph-js": "1.4.0",
    "@vamosdalian/gitgraph-react": "1.6.0"
  },
  "devDependencies": {
    "mdx-deck": "https://github.com/nicoespeon/mdx-deck.git#gitgraphjs-custom-build",
    "mdx-deck-code-surfer": "0.5.5",
    "prism-react-renderer": "0.1.6",
    "raw-loader": "0.5.1",
    "react": "16.8.4",
    "react-dom": "16.8.4",
    "react-github-corner": "2.3.0",
    "react-syntax-highlighter": "10.2.1",
    "styled-components": "4.2.0",
    "webpack-node-externals": "1.7.2"
  }
}
