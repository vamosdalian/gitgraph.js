{
  "name": "@vamosdalian/gitgraph-node",
  "version": "2.0.3",
  "description": "Draw Git graphs in a Node.js terminal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vamosdalian/gitgraph.js.git",
    "directory": "packages/gitgraph-node"
  },
  "bugs": {
    "url": "https://github.com/vamosdalian/gitgraph.js/issues"
  },
  "homepage": "https://github.com/vamosdalian/gitgraph.js/tree/master/packages/gitgraph-node#readme",
  "keywords": [
    "node",
    "terminal",
    "git",
    "graph",
    "javascript"
  ],
  "type": "module",
  "main": "./lib/index.cjs",
  "module": "./lib/index.mjs",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.mjs",
      "require": "./lib/index.cjs"
    }
  },
  "files": [
    "lib",
    "CHANGELOG.md",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json && rollup -c rollup.config.mjs",
    "clean": "rimraf lib",
    "example:default": "tsx examples/default.ts",
    "example:branches": "tsx examples/branches.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@vamosdalian/gitgraph-core": "2.0.3",
    "chalk": "4.1.2"
  },
  "devDependencies": {
    "tsx": "4.23.12"
  }
}
