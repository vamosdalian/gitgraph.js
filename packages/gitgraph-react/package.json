{
  "name": "@vamosdalian/gitgraph-react",
  "version": "2.0.3",
  "description": "Render Git graphs with React",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vamosdalian/gitgraph.js.git",
    "directory": "packages/gitgraph-react"
  },
  "bugs": {
    "url": "https://github.com/vamosdalian/gitgraph.js/issues"
  },
  "homepage": "https://github.com/vamosdalian/gitgraph.js/tree/master/packages/gitgraph-react#readme",
  "keywords": [
    "react",
    "git",
    "graph",
    "javascript"
  ],
  "type": "module",
  "main": "./lib/index.cjs",
  "module": "./lib/index.mjs",
  "browser": "./lib/bundle.umd.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.mjs",
      "require": "./lib/index.cjs"
    }
  },
  "files": [
    "lib",
    "CHANGELOG.md",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json && rollup -c rollup.config.mjs",
    "clean": "rimraf lib",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@vamosdalian/gitgraph-core": "2.0.3"
  },
  "peerDependencies": {
    "react": ">=18.0.0 <20.0.0"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
