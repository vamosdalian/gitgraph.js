{
  "name": "@vamosdalian/gitgraph-js",
  "version": "2.0.2",
  "description": "Draw Git graphs in the browser",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vamosdalian/gitgraph.js.git",
    "directory": "packages/gitgraph-js"
  },
  "bugs": {
    "url": "https://github.com/vamosdalian/gitgraph.js/issues"
  },
  "homepage": "https://github.com/vamosdalian/gitgraph.js/tree/master/packages/gitgraph-js#readme",
  "keywords": [
    "git",
    "graph",
    "javascript",
    "browser"
  ],
  "type": "module",
  "main": "./lib/index.cjs",
  "module": "./lib/index.mjs",
  "browser": "./lib/gitgraph.umd.js",
  "unpkg": "./lib/gitgraph.umd.min.js",
  "jsdelivr": "./lib/gitgraph.umd.min.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.mjs",
      "require": "./lib/index.cjs"
    }
  },
  "files": [
    "lib",
    "CHANGELOG.md",
    "README.md",
    "MIGRATE_FROM_GITGRAPH.JS.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json && rollup -c rollup.config.mjs",
    "clean": "rimraf lib",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@vamosdalian/gitgraph-core": "2.0.2"
  }
}
